SITE_URL=https://grupodipanda.com
CONTACT_ENABLED=true
CONTACT_PROVIDER=smtp
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=geral@grupodipanda.com
# Set the mailbox password locally in .env and in Vercel Environment Variables.
# Never commit the real password or paste it into chat.
SMTP_PASSWORD=
CONTACT_FROM_EMAIL=geral@grupodipanda.com
CONTACT_TO_EMAIL=geral@grupodipanda.com
# Optional shared rate limiting; basic per-instance limits work without this.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Required only with Upstash: random secret of at least 32 characters.
RATE_LIMIT_KEY_SECRET=
# Confirmed public identity of the individual or company responsible for this site.
LEGAL_CONTROLLER_NAME=Paulo Panda
LEGAL_TAX_ID=
LEGAL_ADDRESS=
# Approved plain-text notices: actual retention and actual providers/transfers.
LEGAL_RETENTION_NOTICE=
LEGAL_PROCESSORS_NOTICE=
LEGAL_CONSUMER_NOTICE=
# Actual registered complaints/competent ADR links only, if applicable.
LEGAL_COMPLAINTS_URL=
LEGAL_ADR_URL=
LEGAL_LAST_REVIEW_DATE=
