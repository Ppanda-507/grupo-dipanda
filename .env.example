SITE_URL=https://www.example.com
# Set true only when the contact provider and rate limiter are configured.
CONTACT_ENABLED=false
# Verified sender/domain in Resend. Never commit an actual API key.
RESEND_API_KEY=
CONTACT_FROM_EMAIL=Dipanda <contacto@example.com>
CONTACT_TO_EMAIL=geral@grupodipanda.com
# Durable rate limiting for the Vercel contact function; separate preview/prod stores.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Random secret, at least 32 characters; never commit the real value.
RATE_LIMIT_KEY_SECRET=
# Confirmed public identity of the individual or company responsible for this site.
LEGAL_CONTROLLER_NAME=Paulo Panda
LEGAL_TAX_ID=
LEGAL_ADDRESS=
# Approved plain-text notices: actual retention and actual providers/transfers.
LEGAL_RETENTION_NOTICE=
LEGAL_PROCESSORS_NOTICE=
LEGAL_CONSUMER_NOTICE=
# Actual registered complaints/competent ADR links only, if applicable.
LEGAL_COMPLAINTS_URL=
LEGAL_ADR_URL=
LEGAL_LAST_REVIEW_DATE=
